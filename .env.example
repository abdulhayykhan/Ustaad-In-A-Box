# Ustaad-in-a-Box Environment Configuration Template (OPTIONAL)
# The system works without a key: it falls back to the rule engine's canonical text
# and local faster-whisper. A key only enables cloud phrasing + cloud transcription.
GROQ_API_KEY=your_groq_api_key_here
# Check the exact model id at https://console.groq.com/docs/models
GROQ_MODEL=qwen/qwen3-32b
